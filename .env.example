# Шаблон переменных окружения для запуска backend/notification ПРЯМО НА ХОСТЕ
# (без Docker; инфраструктура при этом поднимается через `make dev`).
#
# Для docker-compose используется свой файл: deploy/compose/.env
# (генерируется командой `make dev-env` из deploy/compose/.env.example).
# Для Kubernetes секреты генерируются `make k8s-secrets` —
# см. deploy/k8s/overlays/*/secrets/*.env.example.

APP_ENV=dev

# PostgreSQL (compose пробрасывает 5432 на localhost)
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# KeyDB (кэш, префикс ключей crm:v1:)
KEYDB_URL=redis://localhost:6379/0

# MinIO S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_FILES=crm-files
S3_BUCKET_IMPORTS=crm-imports
S3_BUCKET_EXPORTS=crm-exports

# Keycloak (realm crm; в dev браузер и backend видят его на localhost:8080)
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/crm
KEYCLOAK_REALM=crm

# Сервисы-сателлиты
LMS_BASE_URL=http://localhost:8020
CMS_BASE_URL=http://localhost:8030
NOTIFICATION_BASE_URL=http://localhost:8010
BACKEND_BASE_URL=http://localhost:8000

# Шифрование ПДн (152-ФЗ). Сгенерировать:
#   PII_FERNET_KEYS: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PII_HMAC_KEY:    openssl rand -base64 32
PII_FERNET_KEYS=
PII_HMAC_KEY=

# Межсервисная аутентификация внутри контура
INTERNAL_API_TOKEN=dev-internal-token
LMS_WEBHOOK_SECRET=dev-lms-secret
CMS_WEBHOOK_SECRET=dev-cms-secret

# Notification-service (Telegram; пусто => канал работает в режиме console-заглушки)
TELEGRAM_BOT_TOKEN=
KC_CLIENT_ID=crm-notification
KC_CLIENT_SECRET=dev-notification-secret

# Порог «зависших» заявок по умолчанию, дни (каскад rule → stage → workflow → app_setting)
STUCK_DEFAULT_DAYS=14
