<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="«Альма» — CRM взаимодействия с вузами" id="alma-model" version="4.9.0">
  <folder name="Стратегия" id="alma-folder-strategy" type="strategy"/>
  <folder name="Бизнес" id="alma-folder-business" type="business">
    <element xsi:type="archimate:BusinessRole" name="КАМ" id="alma-role-kam">
      <documentation>Ведёт свой портфель заявок и вузов; видит все заявки, правит свои</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Код роли" value="kam"/>
      <property key="Прав в наборе" value="28"/>
      <property key="Источник" value="backend/app/core/rbac_catalog.py"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Руководитель КАМов" id="alma-role-head-kam">
      <documentation>Все заявки и справочники, распределение заявок, правка схемы процесса через согласование</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Код роли" value="head_kam"/>
      <property key="Прав в наборе" value="42"/>
      <property key="Источник" value="backend/app/core/rbac_catalog.py"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Администратор" id="alma-role-admin">
      <documentation>Полный доступ. Права и область не редактируются — это защищает систему от потери управления</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Код роли" value="admin"/>
      <property key="Прав в наборе" value="61"/>
      <property key="Источник" value="backend/app/core/rbac_catalog.py"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Наблюдатель" id="alma-role-observer">
      <documentation>Только чтение: заявки, справочники, отчёты по всем КАМам, аудит; ПДн маскированы</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Код роли" value="observer"/>
      <property key="Прав в наборе" value="14"/>
      <property key="Источник" value="backend/app/core/rbac_catalog.py"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Свои роли: «КАМ B2B», «КАМ B2C»" id="alma-role-custom">
      <documentation>Пример ролей, собранных администратором без программиста: права КАМа в одном процессе (демо-сид). Любая своя роль — набор прав из каталога и область.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Код роли" value="kam_b2b, kam_b2c"/>
      <property key="Источник" value="backend/app/tools/seed.py"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Вуз-партнёр" id="alma-actor-university">
      <documentation>Сторона взаимодействия: контакты вуза, заявки B2B, договоры и обучение.</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Клиент или абитуриент" id="alma-actor-client">
      <documentation>Физическое или юридическое лицо: заявки B2C, в том числе лиды с сайта через CMS.</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Ведение вузов и контактов" id="alma-fn-universities">
      <documentation>Карточки вузов, контакты ответственных лиц, регион, закреплённый КАМ.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="universities:write"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Ведение договоров, продуктов и программ" id="alma-fn-contracts">
      <documentation>Договоры по схеме «1 договор — N продуктов» с лицензиями и файлами, каталог продуктов, программы обучения и их ручной приоритет.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="contracts:write, products:write, programs:write, programs:priority"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Обработка заявок B2B и B2C" id="alma-fn-requests">
      <documentation>Заявки вузов (B2B) и физических и юридических лиц (B2C): создание, переходы по этапам процесса, комментарии с @упоминаниями, файлы, назначение ответственного.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="requests:write, requests:transition"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Управление процессами и согласование" id="alma-fn-workflow">
      <documentation>Правка графа этапов в визуальном конструкторе. Опасные правки уходят на согласование администратору; после публикации открытые заявки переводятся на новую схему одной транзакцией.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="workflow:change, workflow:approve"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Работа с пулом талантов" id="alma-fn-talent">
      <documentation>Студенты и воронка «кандидат → пул талантов», активности и расписание, запись студентов на активности. ПДн маскируются по умолчанию.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="students:write, activities:write, activities:participants"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Контроль активности КАМов и сроков" id="alma-fn-kam-control">
      <documentation>Кто, когда и с какими вузами взаимодействовал, на каких этапах заявки останавливаются, какие этапы просрочены — по всем КАМам области роли.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="reports:all"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Аналитика и отчётность" id="alma-fn-analytics">
      <documentation>Интерактивные панели с фильтрами и детализацией, выгрузка реестров и отчётов.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="reports:read, export:run"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Управление доступом: роли и права" id="alma-fn-access">
      <documentation>Свои роли из каталога прав без программиста, область роли (процессы B2B и B2C, записи «все» или «только свои»), назначение ролей, руководители для эскалаций.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="admin:roles, admin:users_write"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Аудит и защита персональных данных" id="alma-fn-audit">
      <documentation>Журнал действий пользователей, раскрытий ПДн и обмена с внешними системами.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="admin:audit"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Обмен данными с LMS и CMS" id="alma-fn-exchange">
      <documentation>Двусторонний обмен с LMS и CMS: единый JSON-конверт с HMAC-подписью, outbox, повторные попытки и очередь недоставленных; администратор контролирует журнал и повторяет доставку.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="admin:integrations"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Загрузка данных из файлов" id="alma-fn-import">
      <documentation>Диалоговый импорт XLSX, XLS, CSV и JSON: сопоставление колонок с шаблонами, устойчивость к кодировкам, построчный отчёт ошибок.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="import:run, import:dictionaries"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Оповещение и эскалация" id="alma-fn-notify">
      <documentation>Уведомления в интерфейсе и в Telegram, правила и пороги, эскалация зависших заявок по каскаду «ответственный → руководитель».</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="notifications:self, notification_rules:write"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Ведение справочников и настроек" id="alma-fn-settings">
      <documentation>Справочники, ИТ-направления, фичефлаги и системные настройки.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="admin:dictionaries, admin:settings, admin:flags"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Адаптация и самообслуживание" id="alma-fn-selfservice">
      <documentation>Встроенная справка, интерактивные туры по ролям, глобальный поиск, личные пресеты реестров — доступны каждому пользователю.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Права функции" value="все роли"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Пользователи CRM (браузер, VPN)" id="alma-actor-users">
      <documentation>КАМы, руководители, администраторы, наблюдатели и свои роли; работают из браузера внутри закрытого контура.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
  </folder>
  <folder name="Приложения" id="alma-folder-application" type="application">
    <element xsi:type="archimate:ApplicationService" name="Реестр вузов и контактов" id="alma-svc-universities">
      <documentation>Реестр и карточка вуза: контакты, регион, ответственный КАМ, связанные договоры.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/universities*"/>
      <property key="Права" value="universities:read, universities:write, universities:delete, contacts:delete"/>
      <property key="Экран" value="/registry/universities"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Реестр договоров" id="alma-svc-contracts">
      <documentation>Договор «1 договор — N продуктов», лицензии по продуктам, файлы договора.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/contracts*"/>
      <property key="Права" value="contracts:read, contracts:write, contracts:delete, contracts:files_delete"/>
      <property key="Экран" value="/registry/contracts"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Каталог продуктов" id="alma-svc-products">
      <documentation>Каталог ИТ-продуктов и вендоров.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/products*"/>
      <property key="Права" value="products:read, products:write, products:delete"/>
      <property key="Экран" value="/registry/products"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Программы и ручной приоритет" id="alma-svc-programs">
      <documentation>Программы обучения, их ручное ранжирование, востребованность по заявкам.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/programs*"/>
      <property key="Права" value="programs:read, programs:write, programs:priority, programs:delete"/>
      <property key="Экран" value="/registry/programs"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Реестр и доска заявок" id="alma-svc-board">
      <documentation>Канбан по этапам процесса с подсветкой разрешённых переходов и реестр заявок.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/requests; /api/v1/requests/board"/>
      <property key="Права" value="requests:read, requests:write"/>
      <property key="Экран" value="/board"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Карточка заявки: комментарии, файлы" id="alma-svc-request-card">
      <documentation>Карточка заявки: история переходов, комментарии с @упоминаниями, файлы по этапам, переоткрытие закрытых заявок.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/requests/{request_id}*"/>
      <property key="Права" value="requests:read, requests:write, comments:write, requests:files, requests:reopen"/>
      <property key="Экран" value="/requests/:id"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Переходы по графу этапов" id="alma-svc-transitions">
      <documentation>Переход проверяется по живой схеме процесса: разрешённое ребро, роль, обязательный комментарий у возврата; история пишется в той же транзакции.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/requests/{request_id}/transitions"/>
      <property key="Права" value="requests:transition"/>
      <property key="Экран" value="/board"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Назначение и передача портфеля" id="alma-svc-assign">
      <documentation>Взять заявку на себя, назначить ответственного, передать открытые заявки и вузы уходящего КАМа другому сотруднику одним действием.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/requests/{request_id}/assign; /api/v1/requests/transfer-portfolio"/>
      <property key="Права" value="requests:assign, requests:assign_any, universities:assign"/>
      <property key="Экран" value="/board"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Конструктор процессов" id="alma-svc-designer">
      <documentation>Визуальный редактор графа этапов: ветвления, возвраты, пороги зависания, предпросмотр влияния правки на открытые заявки.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/workflows*"/>
      <property key="Права" value="workflow:read, workflow:history, workflow:change"/>
      <property key="Экран" value="/workflow"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Согласование изменений схемы" id="alma-svc-approvals">
      <documentation>Пакет опасных правок уходит на согласование; публикация — после одобрения.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/workflows/changes/{change_id}/approve; /api/v1/workflows/changes/{change_id}/reject"/>
      <property key="Права" value="workflow:approve"/>
      <property key="Экран" value="/admin/approvals"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Перевод заявок на новую схему" id="alma-svc-migration">
      <documentation>При публикации схемы открытые заявки удаляемых этапов переводятся одной транзакцией: один SQL-оператор на этап (modules/workflow/migration.py).</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/workflows/changes/{change_id}/approve"/>
      <property key="Права" value="workflow:approve"/>
      <property key="Экран" value="/admin/approvals"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Реестр студентов" id="alma-svc-students">
      <documentation>Студенты и смена статуса по воронке «кандидат → пул талантов»; ПДн в БД зашифрованы, в интерфейсе маскированы.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/students*"/>
      <property key="Права" value="students:read, students:write, students:files, students:delete"/>
      <property key="Экран" value="/talent-pool"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Раскрытие ПДн с аудитом" id="alma-svc-reveal">
      <documentation>Раскрытие персональных данных студента — только по праву и с записью в аудит.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/students/{student_id}/reveal"/>
      <property key="Права" value="students:reveal"/>
      <property key="Экран" value="/talent-pool/students/:id"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Активности и расписание" id="alma-svc-activities">
      <documentation>Мероприятия и курсы с расписанием, запись студентов.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/activities*"/>
      <property key="Права" value="activities:read, activities:write, activities:participants"/>
      <property key="Экран" value="/talent-pool"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Аналитическая панель" id="alma-svc-dashboard">
      <documentation>Воронка, нагрузка КАМов, зависшие заявки, покрытие вузов, востребованность программ, пул талантов, динамика; фильтры и экспорт PNG.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/reports/dashboard; /api/v1/reports/funnel; /api/v1/reports/kam-workload; /api/v1/reports/stuck; /api/v1/reports/universities-coverage; /api/v1/reports/programs-demand; /api/v1/reports/talent-pool-funnel; /api/v1/reports/dynamics"/>
      <property key="Права" value="reports:read, reports:all"/>
      <property key="Экран" value="/dashboard"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Отчёт «Активность КАМов»" id="alma-svc-kam-activity">
      <documentation>Детализация «КАМ → вузы → заявки» и сводка для заказчика: KPI с дельтами, конверсия по этапам, где застревают заявки; выгрузка XLSX и PDF.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/reports/kam-activity*"/>
      <property key="Права" value="reports:read, reports:all"/>
      <property key="Экран" value="/reports/kam-activity"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Отчёт «Взаимодействия за период»" id="alma-svc-interactions">
      <documentation>Взаимодействия КАМов с вузами за период по колонкам отчёта, с выгрузкой.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/reports/interactions"/>
      <property key="Права" value="reports:read, reports:all"/>
      <property key="Экран" value="/reports/kam-activity"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Просрочки по срокам этапов" id="alma-svc-sla">
      <documentation>Вкладка «Просрочки» отчёта «Активность КАМов»: заявки дольше нормы этапа, корзины задержки, атрибуция на дату.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/reports/sla"/>
      <property key="Права" value="reports:read, reports:all"/>
      <property key="Экран" value="/reports/kam-activity"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Сводка ИИ по отчёту КАМов" id="alma-svc-ai-summary">
      <documentation>Сводка фактов по команде и по КАМу поверх цифр «Сводки для заказчика» и «Просрочек»: GigaChat через llm-gateway получает только агрегаты и псевдонимы, числа ответа сверяются с отчётом; без GigaChat — сводка по правилам. За фичефлагом ai_summaries.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/reports/ai-summaries*"/>
      <property key="Права" value="reports:ai_summary"/>
      <property key="Экран" value="/reports/kam-activity"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Экспорт XLSX, CSV, JSON, PDF" id="alma-svc-export">
      <documentation>Выгрузка реестров и отчётов; ПДн маскируются по правам выгружающего.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/export/jobs*"/>
      <property key="Права" value="export:run"/>
      <property key="Экран" value="/dashboard"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Вход и профиль доступа" id="alma-svc-login">
      <documentation>Вход через self-hosted Keycloak (OIDC + PKCE); профиль отдаёт роли, права и область по процессам. Каждая проверка права — на backend.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/auth/me"/>
      <property key="Экран" value="/login"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Роли и права" id="alma-svc-roles">
      <documentation>Редактор ролей: каталог прав по группам, зависимости прав, область роли; изменения действуют без перезахода.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/admin/roles*; /api/v1/admin/permissions; /api/v1/roles"/>
      <property key="Права" value="admin:roles"/>
      <property key="Экран" value="/admin/roles"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Пользователи и назначение ролей" id="alma-svc-users">
      <documentation>Список пользователей, назначение ролей, руководители для эскалаций, синхронизация с Keycloak.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/admin/users*; /api/v1/admin/users/{user_id}/roles"/>
      <property key="Права" value="admin:users, admin:users_write, admin:roles"/>
      <property key="Экран" value="/admin/users"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Журнал аудита" id="alma-svc-audit">
      <documentation>Журнал действий (append-only), в том числе раскрытий ПДн.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/admin/audit-log"/>
      <property key="Права" value="admin:audit"/>
      <property key="Экран" value="/admin/audit"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Приём событий LMS" id="alma-svc-lms-in">
      <documentation>Вебхук LMS: JSON-конверт с HMAC-подписью, идемпотентность по event_id.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/integrations/lms/webhook"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Приём лидов CMS" id="alma-svc-cms-in">
      <documentation>Вебхук CMS: лиды с сайта становятся заявками B2C.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/integrations/cms/webhook"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Отправка событий (outbox, DLQ)" id="alma-svc-outbox">
      <documentation>Транзакционный outbox в PostgreSQL, ретраи 1 м → 5 м → 30 м → 2 ч → 6 ч, затем очередь недоставленных; транспорт — сменный адаптер.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/internal/jobs/outbox-relay"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Журнал обмена и повтор" id="alma-svc-intg-journal">
      <documentation>Журнал событий обмена с LMS и CMS и ручной повтор доставки.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/admin/integration/events*"/>
      <property key="Права" value="admin:audit, admin:integrations"/>
      <property key="Экран" value="/admin/integrations"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Мастер импорта файлов" id="alma-svc-import">
      <documentation>XLSX, XLS (BIFF), CSV и JSON: автоопределение кодировки, сопоставление колонок, проверка и применение с построчным отчётом ошибок.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/import/sessions*"/>
      <property key="Права" value="import:run, import:dictionaries"/>
      <property key="Экран" value="/import"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Уведомления в интерфейсе" id="alma-svc-inbox">
      <documentation>Лента уведомлений пользователя и отметка о прочтении.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/notifications; /api/v1/notifications/read"/>
      <property key="Права" value="notifications:self"/>
      <property key="Экран" value="/settings/notifications"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Каналы и привязка Telegram" id="alma-svc-notify-settings">
      <documentation>Личные настройки каналов, привязка Telegram по коду, тестовое сообщение.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/notifications/settings; /api/v1/notifications/channels; /api/v1/notifications/telegram/link-code"/>
      <property key="Права" value="notifications:self"/>
      <property key="Экран" value="/settings/notifications"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Правила уведомлений" id="alma-svc-rules">
      <documentation>Правила рассылки по событиям и пороги эскалации.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/notifications/rules*"/>
      <property key="Права" value="notification_rules:read, notification_rules:write"/>
      <property key="Экран" value="/settings/notifications"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Telegram-бот" id="alma-svc-bot">
      <documentation>Уведомления и команды бота строго по правам привязанного пользователя; вход сервиса — client credentials Keycloak.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/internal/bot/bind; /api/v1/internal/bot/users/{chat_id}/requests"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Эскалация зависших заявок" id="alma-svc-stuck">
      <documentation>Ежечасная проверка порогов зависания (этап → процесс → глобальная настройка): уведомление ответственному при 1× порога, руководителю при 1,5×.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/internal/jobs/check-stuck-requests"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Справочники" id="alma-svc-dictionaries">
      <documentation>Справочники системы с правкой в интерфейсе и импортом из файла.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/admin/dictionaries*"/>
      <property key="Права" value="admin:dictionaries, import:dictionaries"/>
      <property key="Экран" value="/admin/dictionaries"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="ИТ-направления" id="alma-svc-directions">
      <documentation>Справочник ИТ-направлений для вузов, продуктов и отчётов.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/it-directions*"/>
      <property key="Права" value="admin:dictionaries"/>
      <property key="Экран" value="/admin/dictionaries"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Фичефлаги и настройки" id="alma-svc-flags">
      <documentation>Включение функций без выкладки и системные пороги.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/admin/feature-flags*; /api/v1/admin/settings; /api/v1/flags"/>
      <property key="Права" value="admin:flags, admin:settings"/>
      <property key="Экран" value="/admin/feature-flags"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Файлы и вложения" id="alma-svc-files">
      <documentation>Файлы заявок, договоров и студентов в MinIO; скачивание по правам.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/files/{file_id}/download"/>
      <property key="Права" value="files:business, files:others"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Обновление экранов (SSE)" id="alma-svc-sse">
      <documentation>Server-Sent Events: публикация схемы, переходы, комментарии и смена прав обновляют открытые экраны без перезагрузки.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/events/stream"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Глобальный поиск" id="alma-svc-search">
      <documentation>Поиск по вузам, заявкам, договорам и другим сущностям в области прав.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/search"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Пресеты реестров" id="alma-svc-presets">
      <documentation>Личные наборы колонок и фильтров реестров.</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="API" value="/api/v1/ui/presets*"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Встроенная справка и туры" id="alma-svc-help">
      <documentation>Руководство пользователя и администратора внутри интерфейса, туры по ролям, контрольный список «Начало работы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
      <property key="Экран" value="/help"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="LMS заказчика" id="alma-ext-lms">
      <documentation>Система обучения: двусторонний обмен заявками, статусами и событиями обучения. На стенде её заменяет lms-stub.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="CMS-сайт заказчика" id="alma-ext-cms">
      <documentation>Сайт: каталог программ и лиды. На стенде её заменяет cms-stub.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Telegram Bot API" id="alma-ext-telegram">
      <documentation>Доставка уведомлений и команды бота; доступен только из notification-service.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Email (Exchange) и Max" id="alma-ext-channels">
      <documentation>Каналы-заглушки notification-service: сообщение пишется в журнал, адаптер заменяется без смены кода ядра.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GigaChat API (Сбер)" id="alma-ext-gigachat">
      <documentation>Модель для «Сводки ИИ»: OAuth ngw.devices.sberbank.ru:9443, чат gigachat.devices.sberbank.ru:443; доступен только из llm-gateway. Оператор в РФ; on-prem GigaChat подключается переменными GIGACHAT_*_URL.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="frontend — интерфейс" id="alma-ac-frontend">
      <documentation>SPA на React 18 и TypeScript: реестры, доска, конструктор процессов, панели ECharts, справка. Отдаётся nginx-unprivileged.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="frontend"/>
      <property key="Технологии" value="React 18, TypeScript, Vite, Tailwind CSS v4, TanStack Query и Table, @xyflow/react, ECharts, keycloak-js"/>
      <property key="Порт" value="8080 (Service 80)"/>
      <property key="Манифест" value="deploy/k8s/base/frontend"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="backend — ядро CRM" id="alma-ac-backend">
      <documentation>Модульный монолит FastAPI: REST /api/v1 со Swagger, SSE, outbox, задания CronJob. Один образ для API, миграций и засева.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend"/>
      <property key="Технологии" value="Python 3.12, FastAPI, SQLAlchemy 2 (async), Alembic, Pydantic v2, Uvicorn"/>
      <property key="Порт" value="8000"/>
      <property key="Манифест" value="deploy/k8s/base/backend"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="lms-stub — заглушка LMS" id="alma-ac-lms-stub">
      <documentation>Отдельный под с журналом обмена: принимает события CRM и шлёт вебхуки.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="services/lms-stub"/>
      <property key="Технологии" value="FastAPI, SQLite"/>
      <property key="Порт" value="8020"/>
      <property key="Манифест" value="deploy/k8s/base/lms-stub"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="cms-stub — заглушка CMS" id="alma-ac-cms-stub">
      <documentation>Отдельный под: демо-форма лида и журнал обмена.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="services/cms-stub"/>
      <property key="Технологии" value="FastAPI, SQLite"/>
      <property key="Порт" value="8030"/>
      <property key="Манифест" value="deploy/k8s/base/cms-stub"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Keycloak 26 — вход" id="alma-ac-keycloak">
      <documentation>Self-hosted Keycloak, realm crm: OIDC + PKCE для интерфейса, client credentials для сервисов. Роли и права — в БД CRM, Keycloak отвечает за вход.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="deploy/keycloak"/>
      <property key="Технологии" value="Keycloak 26 (start --import-realm)"/>
      <property key="Порт" value="8080"/>
      <property key="Манифест" value="deploy/k8s/base/keycloak"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="notification-service" id="alma-ac-notification">
      <documentation>Служба уведомлений и Telegram-бот: HTTP-relay каналов и long-polling aiogram. Выход в интернет — только к Telegram; токен бота видит только он.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="services/notification"/>
      <property key="Технологии" value="FastAPI, aiogram 3"/>
      <property key="Порт" value="8010"/>
      <property key="Манифест" value="deploy/k8s/base/notification"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="llm-gateway — шлюз GigaChat" id="alma-ac-llm-gateway">
      <documentation>Единственный, кто знает ключ GigaChat и ходит к нему (443, 9443): очередь на один поток, дневной лимит токенов, OAuth и TLS НУЦ Минцифры. Промпт, факты и проверка ответа — в модуле ai_summary backend.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="services/llm-gateway"/>
      <property key="Технологии" value="FastAPI, httpx"/>
      <property key="Порт" value="8040"/>
      <property key="Манифест" value="deploy/k8s/base/llm-gateway"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="auth — вход и профиль" id="alma-mod-auth">
      <documentation>Профиль, роли и права из БД.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/auth"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="access — роли и права" id="alma-mod-access">
      <documentation>Роли, каталог прав, назначение ролей; загрузка каталога из кода.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/access"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="workflow — движок процессов" id="alma-mod-workflow">
      <documentation>Графы этапов, переходы, пакеты изменений, перевод заявок, пороги зависания.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/workflow"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="requests — заявки" id="alma-mod-requests">
      <documentation>Заявки B2B и B2C, доска, комментарии, файлы, передача портфеля.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/requests"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="crm — вузы, договоры, каталог" id="alma-mod-crm">
      <documentation>Вузы и контакты, договоры, продукты, программы, ИТ-направления.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/crm"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="import_export — импорт и экспорт" id="alma-mod-import-export">
      <documentation>Мастер импорта, выгрузки XLSX/CSV/JSON/PDF, справочники.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/import_export"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="talent_pool — пул талантов" id="alma-mod-talent">
      <documentation>Студенты с шифрованием ПДн, активности и расписание.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/talent_pool"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="reporting — отчёты" id="alma-mod-reporting">
      <documentation>Агрегаты дашборда, отчёт «Активность КАМов», PDF (fpdf2) и XLSX.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/reporting"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ai_summary — сводки ИИ" id="alma-mod-ai-summary">
      <documentation>Факты отчётов с псевдонимами КАМов, задачи и кэш (ai_summary_job), вызов llm-gateway, проверка чисел и советов, сводка по правилам.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/ai_summary"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="integrations — LMS и CMS" id="alma-mod-integrations">
      <documentation>Вебхуки LMS и CMS, конверт с HMAC, outbox, журнал обмена.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/integrations"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="notifications — уведомления" id="alma-mod-notifications">
      <documentation>Лента, правила, каналы, API бота, relay в notification-service.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/notifications"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="files — файлы" id="alma-mod-files">
      <documentation>Хранение и выдача файлов в MinIO.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/files"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="admin — администрирование" id="alma-mod-admin">
      <documentation>Пользователи, настройки, фичефлаги, журнал аудита.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/admin"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ui — SSE, поиск, пресеты" id="alma-mod-ui">
      <documentation>Поток событий SSE, поиск, пресеты.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/ui"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="internal — служебные задания" id="alma-mod-internal">
      <documentation>Эндпоинты CronJob: зависшие заявки, очистки, relay outbox (X-Internal-Token).</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/modules/internal"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="core — сквозные механизмы" id="alma-mod-core">
      <documentation>Ядро прав (require_permission), Idempotency-Key, outbox, SSE-хаб, кэш KeyDB, шифрование ПДн, аудит.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Каталог" value="backend/app/core"/>
    </element>
  </folder>
  <folder name="Технологии" id="alma-folder-technology" type="technology">
    <element xsi:type="archimate:Node" name="Kubernetes: namespace crm" id="alma-node-k8s">
      <documentation>Кластер k3s на ВМ, k3d или minikube; манифесты — kustomize base и overlays. Default-deny NetworkPolicy, разрешения точка-точка между подами.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Манифесты" value="deploy/k8s"/>
      <property key="Пространство имён" value="crm"/>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Ingress-контроллер" id="alma-sw-ingress">
      <documentation>Traefik в k3s и k3d (на ВМ — с TLS от cert-manager), ingress-nginx в minikube: / → интерфейс, /api → ядро, отдельные хосты id, lms, cms и консоль MinIO.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Манифест" value="deploy/k8s/base/ingress"/>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16" id="alma-sw-postgres">
      <documentation>БД crm и keycloak: данные CRM, роли и права, outbox, ключи идемпотентности; ПДн студентов — шифртекст.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Порт" value="5432"/>
      <property key="Манифест" value="deploy/k8s/base/postgres"/>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="KeyDB — кэш и pub/sub" id="alma-sw-keydb">
      <documentation>Cache-aside crm:v1:*, рассылка событий SSE между репликами, идемпотентность отправки уведомлений; без персистентности.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Порт" value="6379"/>
      <property key="Манифест" value="deploy/k8s/base/keydb"/>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="MinIO — файлы (S3)" id="alma-sw-minio">
      <documentation>Бакеты файлов, импортов и выгрузок.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Порт" value="9000, 9001"/>
      <property key="Манифест" value="deploy/k8s/base/minio"/>
    </element>
    <element xsi:type="archimate:TechnologyProcess" name="CronJob: stuck-check, idempotency-purge, purge-deleted" id="alma-tp-cronjobs">
      <documentation>stuck-check — ежечасно, idempotency-purge — ежечасно со сдвигом, purge-deleted — ночью; вызывают служебные эндпоинты ядра с X-Internal-Token. Шаблон demo-reset приостановлен и запускается вручную.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Манифест" value="deploy/k8s/base/cronjobs"/>
    </element>
    <element xsi:type="archimate:TechnologyProcess" name="Job: db-migrate, minio-init, seed-demo" id="alma-tp-jobs">
      <documentation>Миграции Alembic до head, создание бакетов MinIO, засев демо-данных.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Манифест" value="deploy/k8s/base/jobs"/>
    </element>
    <element xsi:type="archimate:Artifact" name="crm/backend" id="alma-art-backend">
      <documentation>Образ контейнера компонента.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Dockerfile" value="backend/Dockerfile"/>
    </element>
    <element xsi:type="archimate:Artifact" name="crm/frontend" id="alma-art-frontend">
      <documentation>Образ контейнера компонента.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Dockerfile" value="frontend/Dockerfile"/>
    </element>
    <element xsi:type="archimate:Artifact" name="crm/notification" id="alma-art-notification">
      <documentation>Образ контейнера компонента.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Dockerfile" value="services/notification/Dockerfile"/>
    </element>
    <element xsi:type="archimate:Artifact" name="crm/llm-gateway" id="alma-art-llm-gateway">
      <documentation>Образ контейнера компонента.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Dockerfile" value="services/llm-gateway/Dockerfile"/>
    </element>
    <element xsi:type="archimate:Artifact" name="crm/lms-stub" id="alma-art-lms-stub">
      <documentation>Образ контейнера компонента.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Dockerfile" value="services/lms-stub/Dockerfile"/>
    </element>
    <element xsi:type="archimate:Artifact" name="crm/cms-stub" id="alma-art-cms-stub">
      <documentation>Образ контейнера компонента.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Dockerfile" value="services/cms-stub/Dockerfile"/>
    </element>
  </folder>
  <folder name="Мотивация" id="alma-folder-motivation" type="motivation">
    <element xsi:type="archimate:Constraint" name="Ядро без выхода в интернет" id="alma-con-no-egress">
      <documentation>Default-deny NetworkPolicy, разрешения точка-точка между подами (deploy/k8s/base/networkpolicy).</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Выход наружу — только DMZ-поды" id="alma-con-single-egress">
      <documentation>notification-service — 443 к Telegram, llm-gateway — 443 и 9443 к GigaChat; токен бота и ключ GigaChat хранятся только в своих подах; с ядром — HTTP точка-точка.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Constraint" name="В GigaChat — только агрегаты и псевдонимы" id="alma-con-ai-facts">
      <documentation>ФИО, вузы, клиенты B2C, заголовки заявок и комментарии наружу не уходят; числа ответа сверяются с отчётом кодом, советы удаляются.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Constraint" name="LMS и CMS на стенде — заглушки" id="alma-con-stubs">
      <documentation>lms-stub и cms-stub говорят с ядром тем же JSON-конвертом с HMAC, что и реальные системы.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Constraint" name="KeyDB без персистентности" id="alma-con-cache">
      <documentation>Сбой кэша деградирует в чтение из PostgreSQL.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Constraint" name="ПДн студентов — шифртекст" id="alma-con-pii">
      <documentation>Fernet на уровне приложения и blind index HMAC для поиска (152-ФЗ).</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
  </folder>
  <folder name="Реализация и миграция" id="alma-folder-implementation-migration" type="implementation_migration"/>
  <folder name="Прочее" id="alma-folder-other" type="other">
    <element xsi:type="archimate:Grouping" name="Роли пользователей" id="alma-grp-roles">
      <documentation>Системные роли засевает миграция; свои роли администратор собирает из каталога прав на экране «Роли и права» и ограничивает процессами (B2B, B2C) и областью записей («все» или «только свои»).</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Внешние участники" id="alma-grp-actors">
      <documentation>Стороны взаимодействия, с которыми работают пользователи CRM.</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Бизнес-функции" id="alma-grp-functions">
      <documentation>Что делают пользователи «Альмы». Назначение роли на функцию рассчитано по каталогу прав: роль выполняет функцию, если в её наборе есть хотя бы одно из прав функции (свойство «Права функции»).</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Реестры" id="alma-grp-svc-registries">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Процессы и заявки" id="alma-grp-svc-processes">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Пул талантов" id="alma-grp-svc-talent">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Отчёты и аналитика" id="alma-grp-svc-reports">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Роли и доступ" id="alma-grp-svc-access">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Интеграции и загрузка данных" id="alma-grp-svc-integrations">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Уведомления" id="alma-grp-svc-notifications">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Общие сервисы" id="alma-grp-svc-common">
      <documentation>Группа прикладных сервисов «Альмы».</documentation>
      <property key="Вид" value="Функциональная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Внешние системы (вне закрытого контура)" id="alma-grp-external">
      <documentation>Системы заказчика и внешние каналы уведомлений.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="tier=app — приложения" id="alma-grp-tier-app">
      <documentation>Интерфейс, ядро CRM и заглушки LMS/CMS.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Метка" value="tier=app"/>
    </element>
    <element xsi:type="archimate:Grouping" name="tier=iam — вход" id="alma-grp-tier-iam">
      <documentation>Self-hosted Keycloak, realm crm.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Метка" value="tier=iam"/>
    </element>
    <element xsi:type="archimate:Grouping" name="tier=dmz — выход наружу" id="alma-grp-tier-dmz">
      <documentation>notification-service и llm-gateway; в целевой архитектуре — отдельный сегмент DMZ.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Метка" value="tier=dmz"/>
    </element>
    <element xsi:type="archimate:Grouping" name="tier=data — хранилища" id="alma-grp-tier-data">
      <documentation>PostgreSQL, MinIO, KeyDB.</documentation>
      <property key="Вид" value="Компонентная схема"/>
      <property key="Метка" value="tier=data"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Задания Kubernetes" id="alma-grp-jobs">
      <documentation>Плановые и разовые задания кластера.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Образы контейнеров" id="alma-grp-images">
      <documentation>Собственные образы; собираются из Dockerfile каталога компонента.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Условия и ограничения контура" id="alma-grp-constraints">
      <documentation>Архитектурные ограничения, которые соблюдает развёртывание.</documentation>
      <property key="Вид" value="Компонентная схема"/>
    </element>
  </folder>
