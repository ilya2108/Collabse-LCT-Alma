  "clients": [
    {
      "clientId": "crm-frontend",
      "name": "CRM Frontend (SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "http://crm.local",
      "baseUrl": "/",
      "redirectUris": [
        "http://crm.localhost/*",
        "http://crm.local/*",
        "http://localhost:5173/*",
        "http://localhost/*",
        "https://crm.168-113-158-10.nip.io/*"
      ],
      "webOrigins": [
        "+",
        "http://crm.localhost",
        "https://crm.168-113-158-10.nip.io"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://crm.localhost/*##http://crm.local/*##http://localhost:5173/*##http://localhost/*##https://crm.168-113-158-10.nip.io/*"
      }
    },
    {
      "clientId": "crm-notification",
      "name": "Notification Service (Telegram-бот)",
      "description": "Confidential-клиент: client credentials для вызовов /internal/bot/* backend'а",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.NOTIFICATION_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    },
    {
      "clientId": "crm-integration",
      "name": "Integration Gateway",
      "description": "Confidential-клиент: bearer-альтернатива HMAC для webhook'ов (по умолчанию не используется)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.INTEGRATION_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    },
    {
      "clientId": "crm-loadtest",
      "name": "Load Testing (k6)",
      "description": "Direct Access Grants включён ТОЛЬКО у этого клиента — боевые клиенты чисты",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.LOADTEST_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    },
    {
      "clientId": "crm-backend-admin",
      "name": "Backend Admin Sync",
      "description": "Confidential-клиент backend'а: client credentials + view-users (realm-management) для синка пользователей из Keycloak Admin API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.BACKEND_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ]
}
