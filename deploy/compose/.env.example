# Шаблон окружения docker-compose (дев-стенд). `make dev-env` копирует его в
# deploy/compose/.env и заменяет плейсхолдеры __GEN_*__ на случайные значения.
# .env — в .gitignore; ключи ПДн стабильны между запусками (файл не перетирается).

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# Keycloak bootstrap-админ (консоль http://localhost:8080)
KC_ADMIN_PASSWORD=admin

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Шифрование ПДн (152-ФЗ): генерируются автоматически, в git не попадают
PII_FERNET_KEYS=__GEN_FERNET_PII__
PII_HMAC_KEY=__GEN_B64_PIIHMAC__

# Межсервисная аутентификация внутри контура
INTERNAL_API_TOKEN=dev-internal-token
LMS_WEBHOOK_SECRET=dev-lms-secret
CMS_WEBHOOK_SECRET=dev-cms-secret

# Секреты confidential-клиентов Keycloak (подставляются в realm при импорте)
NOTIFICATION_CLIENT_SECRET=dev-notification-secret
INTEGRATION_CLIENT_SECRET=dev-integration-secret
LOADTEST_CLIENT_SECRET=dev-loadtest-secret
BACKEND_ADMIN_CLIENT_SECRET=dev-backend-admin-secret

# Telegram-бот: пусто => канал TG работает в режиме console-заглушки
TELEGRAM_BOT_TOKEN=
