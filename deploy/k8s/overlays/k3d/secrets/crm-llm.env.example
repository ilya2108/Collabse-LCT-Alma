# Ключ GigaChat видит ТОЛЬКО llm-gateway (второй под с egress). Пусто => шлюз отвечает
# 503 llm_not_configured, CRM предлагает сводку по правилам. Заполнить: make llm-secret LLM_SRC=…
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_STRONG=GigaChat-2-Pro
GIGACHAT_MODEL_FAST=GigaChat-2
# backend → llm-gateway (X-Internal-Token); backend получает только этот ключ секрета
LLM_GATEWAY_TOKEN=__GEN_HEX_LLMGW__
