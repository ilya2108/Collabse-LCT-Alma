# Ключи шифрования ПДн (152-ФЗ). Видят ТОЛЬКО backend и jobs.
# PII_FERNET_KEYS — список через запятую, первый — активный (MultiFernet);
# ротация = новый ключ первым в списке + python -m app.tools.rekey.
# PII_HMAC_KEY — отдельный ключ blind-index поиска (>=32 байт).
PII_FERNET_KEYS=__GEN_FERNET_PII__
PII_HMAC_KEY=__GEN_B64_PIIHMAC__
